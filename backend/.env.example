# Copy to backend/.env and fill in.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/slg_fieldtrack
# Server-side key with the Geocoding API enabled (never ship this in the app).
GOOGLE_GEOCODING_API_KEY=
# Firebase service-account JSON for FCM pushes (optional but recommended).
FIREBASE_CREDENTIALS_FILE=
UPLOAD_DIR=./uploads
OFFLINE_AFTER_MINUTES=15
REQUEST_TIMEOUT_SECONDS=120
DEFAULT_SITE_RADIUS_M=150
LOW_ACCURACY_THRESHOLD_M=100
PAIR_RATE_LIMIT_PER_MINUTE=10
